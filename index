<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Montserrat:wght@400;600;700;800;900&display=swap" rel="stylesheet">
<style>
:root{
  --verde:#00ff5e; --verde-escuro:#2fcc63; --verde-cta:#00c247;
  --rosa:#ff004c; --rosa-tag:#c0006a; --borda:#f0d6e8;
  --preto:#0a0a0a; --branco:#fff; --cinza:#f5f5f5;
  box-sizing:border-box; padding-top:env(safe-area-inset-top,0px); padding-bottom:env(safe-area-inset-bottom,0px);
}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--branco:#161014;--preto:#f2f2f2;--cinza:#221a1f;--borda:#3d2530;}}
:root[data-theme="dark"]{--branco:#161014;--preto:#f2f2f2;--cinza:#221a1f;--borda:#3d2530;}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
html{scroll-behavior:smooth;scroll-padding-top:env(safe-area-inset-top,0px);}
body{font-family:'Montserrat',Arial,sans-serif;background:var(--branco);color:var(--preto);min-height:100vh;overflow-x:hidden;}
img{max-width:100%;display:block;}
.wrapper{max-width:480px;margin:0 auto;padding:0 0 60px;}
.topo-barra{width:100%;height:6px;background:linear-gradient(90deg,var(--verde),#FFD600,var(--rosa),var(--verde));background-size:300% 100%;animation:shimmer 3s linear infinite;}
@keyframes shimmer{0%{background-position:0% 50%;}100%{background-position:300% 50%;}}
.timer-bar{position:sticky;top:env(safe-area-inset-top,0px);z-index:1000;width:100%;background:var(--rosa);padding:10px 16px;text-align:center;display:flex;align-items:center;justify-content:center;gap:8px;box-shadow:0 2px 12px rgba(255,0,76,.4);}
.timer-bar-text{font-size:13px;font-weight:800;letter-spacing:1.5px;text-transform:uppercase;color:#fff;}
.timer-bar-count{font-family:'Bebas Neue',Arial,sans-serif;font-size:20px;color:#fff;letter-spacing:2px;}
.headline-block{padding:36px 24px 28px;text-align:center;}
.headline-tag{display:inline-block;background:var(--rosa);color:#fff;font-size:11px;font-weight:700;letter-spacing:2px;text-transform:uppercase;padding:5px 14px;border-radius:2px;margin-bottom:18px;}
.headline{font-family:'Bebas Neue',Arial,sans-serif;font-size:clamp(36px,9vw,50px);font-weight:900;line-height:1.1;letter-spacing:-1px;color:var(--preto);}
.headline .destaque{color:var(--rosa);}
.headline .verde{color:var(--verde-escuro);}
.cover{width:230px;margin:20px auto 0;border-radius:14px;box-shadow:0 14px 30px rgba(0,0,0,.18);}
.cta-section{padding:28px 16px 0;}
.cta-btn{display:block;width:100%;padding:20px 24px;background:linear-gradient(135deg,var(--verde) 0%,#00a83c 100%);color:#fff;font-family:'Montserrat',Arial,sans-serif;font-size:16px;font-weight:900;text-transform:uppercase;text-align:center;text-decoration:none;border:none;border-radius:10px;cursor:pointer;box-shadow:0 8px 30px rgba(0,194,71,.4);transition:transform .15s;}
.cta-btn:active{transform:translateY(1px);}
.cta-sub{text-align:center;margin-top:12px;font-size:11px;color:rgba(0,0,0,.4);}
:root[data-theme="dark"] .cta-sub{color:rgba(255,255,255,.5);}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]) .cta-sub{color:rgba(255,255,255,.5);}}
.divisor{height:1px;background:linear-gradient(90deg,transparent,#e0e0e0,transparent);margin:36px 24px;}
.beneficios-section{padding:0 24px;}
