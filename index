<script>
let carrIndex=0; const carrTotal=5; let carrInterval=null;
function atualizarCarrossel(){
  const track=document.getElementById('carrosselTrack');
  if(!track) return;
  track.style.transform='translateX(-'+(carrIndex*100)+'%)';
  document.querySelectorAll('.carr-dot').forEach((dot,i)=>dot.classList.toggle('ativo',i===carrIndex));
}
function moverCarrossel(dir){ carrIndex=(carrIndex+dir+carrTotal)%carrTotal; atualizarCarrossel(); }
function irParaSlide(i){ carrIndex=i; atualizarCarrossel(); }
function iniciarSwipe(){
  const track=document.getElementById('carrosselTrack'); if(!track) return;
  let startX=0;
  track.addEventListener('touchstart',e=>{ if(e.touches&&e.touches.length) startX=e.touches[0].clientX; },{passive:true});
  track.addEventListener('touchend',e=>{
    if(!e.changedTouches||!e.changedTouches.length) return;
    const diff=startX-e.changedTouches[0].clientX;
    if(Math.abs(diff)>40) moverCarrossel(diff>0?1:-1);
  },{passive:true});
}
function toggleFaq(btn){
  const item=btn.parentElement; if(!item) return;
  const aberto=item.classList.contains('aberto');
  document.querySelectorAll('.faq-item').forEach(f=>f.classList.remove('aberto'));
  if(!aberto) item.classList.add('aberto');
}
function iniciarTimer(){
  const KEY='timer_end_acai'; const barEl=document.getElementById('bar-timer'); if(!barEl) return;
  let end=parseInt(sessionStorage.getItem(KEY),10);
  if(!end||end<Date.now()){ end=Date.now()+15*60*1000; try{sessionStorage.setItem(KEY,String(end));}catch(e){} }
  function tick(){
    const diff=Math.max(0,Math.floor((end-Date.now())/1000));
    const m=Math.floor(diff/60), s=diff%60;
    barEl.textContent=String(m).padStart(2,'0')+':'+String(s).padStart(2,'0');
    if(diff<=0){ end=Date.now()+15*60*1000; try{sessionStorage.setItem(KEY,String(end));}catch(e){} }
  }
  tick(); setInterval(tick,1000);
}
document.addEventListener('DOMContentLoaded',function(){ atualizarCarrossel(); iniciarSwipe(); iniciarTimer(); });
window.addEventListener('load',function(){ carrInterval=setInterval(()=>moverCarrossel(1),3200); });
</script>
