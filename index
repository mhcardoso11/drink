.beneficios-intro strong{color:var(--rosa-tag);font-weight:800;}
.beneficios-lista{list-style:none;margin-top:20px;display:flex;flex-direction:column;gap:12px;}
.beneficios-lista li{display:flex;align-items:flex-start;gap:12px;font-size:14px;font-weight:600;color:var(--preto);background:var(--cinza);border:1px solid var(--borda);border-radius:10px;padding:14px 16px;}
.check{flex-shrink:0;width:22px;height:22px;background:var(--verde-cta);color:#fff;border-radius:50%;display:inline-flex;align-items:center;justify-content:center;font-weight:900;font-size:13px;}
.carrossel-section{padding:0 0 4px;}
.carrossel-titulo{text-align:center;font-size:17px;font-weight:900;color:var(--preto);padding:0 24px;margin-bottom:20px;line-height:1.3;}
.carrossel-titulo span{color:var(--rosa);}
.carrossel-wrapper{display:flex;align-items:center;gap:8px;padding:0 10px;}
.carrossel-track-outer{flex:1;overflow:hidden;border-radius:14px;}
.carrossel-track{display:flex;transition:transform .4s cubic-bezier(.4,0,.2,1);}
.carr-slide{min-width:100%;position:relative;border-radius:14px;overflow:hidden;aspect-ratio:1/1;background:#000;}
.carr-slide img{width:100%;height:100%;object-fit:cover;display:block;}
